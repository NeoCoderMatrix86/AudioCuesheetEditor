@inherits BaseLocalizedComponent

@inject IStringLocalizer<GenerateCuesheetDialog> _localizer
@inject ValidationService _validationService
@inject IBlazorDownloadFileService _blazorDownloadFileService
@inject CuesheetExportService _cuesheetExportService

<MudDialog>
    <DialogContent>
        @if (String.IsNullOrEmpty(_validationErrorMessage) == false)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                @_localizer["Export is currently not possible:"]
                @((MarkupString)_validationErrorMessage)
            </MudAlert>
        }
        <MudTextField T="string" Label="@_localizer["Filename"]" Variant="Variant.Outlined" Text="@_options?.CuesheetFilename" TextChanged="CuesheetFilenameChanged"
                      Error="String.IsNullOrEmpty(_fileNameValidationErrorMessage) == false" ErrorText="@_fileNameValidationErrorMessage" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="OnDownloadClick" Disabled="String.IsNullOrEmpty(_validationErrorMessage) == false">@_localizer["Download"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    DownloadOptions? _options;
    String? _fileNameValidationErrorMessage = null;
    String? _validationErrorMessage = null;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _options = await base.LocalStorageOptionsProvider.GetOptionsAsync<DownloadOptions>();
        base.LocalStorageOptionsProvider.OptionSaved += LocalStorageOptionsProvider_OptionSaved;
        SetValidationErrors();
    }

    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);
        base.LocalStorageOptionsProvider.OptionSaved -= LocalStorageOptionsProvider_OptionSaved;
    }

    async Task OnDownloadClick()
    {
        MudDialog?.Close();
        var generateExportResult = _cuesheetExportService.GenerateExportfile(_options!.CuesheetFilename);
        if (generateExportResult.IsSuccess == false)
        {
            throw new InvalidOperationException($"Could not generate export file: {generateExportResult.Error?.Message}");
        }
        var exportfile = generateExportResult.Value!;
        await _blazorDownloadFileService.DownloadFile(exportfile.Name, exportfile.Content, "text/plain");
    }

    void SetValidationErrors()
    {
        _validationErrorMessage = null;
        var result = _cuesheetExportService.CanGenerateExportfile(_options?.CuesheetFilename);
        if (result.IsSuccess == false)
        {
            _validationErrorMessage = result.Error?.Message.Replace(Environment.NewLine, "<br />");
        }
        SetFileNameValidationError();
    }

    void SetFileNameValidationError()
    {
        _fileNameValidationErrorMessage = null;
        var validationMessages = _validationService.Validate(_options, nameof(DownloadOptions.CuesheetFilename));
        if (validationMessages.Count() > 0)
        {
            _fileNameValidationErrorMessage = String.Join(Environment.NewLine, validationMessages);
        }
    }

    async Task CuesheetFilenameChanged(string? newFilename)
    {
        //TODO: an empty filename is not valid and results in options not beeing stored
        await LocalStorageOptionsProvider.SaveOptionsValueAsync<DownloadOptions>(x => x.CuesheetFilename, newFilename);
    }

    void LocalStorageOptionsProvider_OptionSaved(object? sender, IOptions option)
    {
        if (option is DownloadOptions downloadOptions)
        {
            _options = downloadOptions;
            SetValidationErrors();
            StateHasChanged();
        }
    }
}
