@inherits BaseLocalizedComponent

@inject IStringLocalizer<InputTextDialog> _localizer
@inject HotKeys _hotKeys

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_inputValue" Label="@Label" Placeholder="@Placeholder" Variant="Variant.Outlined" Immediate OnKeyDown="TextFieldKeyDown" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="CloseDialogOk">@_localizer["Ok"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    HotKeysContext? _hotKeysContext;
    string? _inputValue;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? InitialValue { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _hotKeysContext = _hotKeys.CreateContext().Add(ModKey.None, Key.Enter, CloseDialogOk);
    }

    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);
        _hotKeysContext?.DisposeAsync();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _inputValue = InitialValue;
    }

    void TextFieldKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            //Use a timer to close the dialog after a short delay to ensure that the keyboard event is fully processed before closing the dialog.
            new System.Threading.Timer(CloseDialogOk, null, 0, 10);
        }
    }

    void CloseDialogOk(object? state = null)
    {
        MudDialog?.Close(_inputValue);
    }
}
