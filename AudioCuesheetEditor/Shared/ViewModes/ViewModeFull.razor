@inherits BaseLocalizedComponent

@inject IStringLocalizer<ViewModeFull> _localizer
@inject ISessionStateContainer _sessionStateContainer
@inject ICuesheetManager _cuesheetManager
@inject IDialogService _dialogService

<MudCard Outlined>
    <MudCardHeader>
        <MudText Typo="Typo.h5">@_localizer["Common data"]</MudText>
    </MudCardHeader>
    <MudCardContent>
        <CuesheetData />
    </MudCardContent>
</MudCard>
<MudCard Outlined>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">@_localizer["Files"]</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudTooltip Text="@_localizer["Add file"]">
                <MudIconButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddButtonClicked" Icon="@Icons.Material.Outlined.Add" aria-label="@_localizer["Add file"]" />
            </MudTooltip>
            <MudButtonGroup OverrideStyles="false">
                <MudTooltip Text="@_localizer["Delete selected files"]">
                    <MudIconButton Color="Color.Warning" Variant="Variant.Filled" OnClick="DeleteButtonClicked" Icon="@Icons.Material.Outlined.Delete" Disabled="_selectedAudiofiles.Count == 0" aria-label="@_localizer["Delete selected files"]" />
                </MudTooltip>
                <MudTooltip Text="@_localizer["Delete all files"]">
                    <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert>
                        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="DeleteAllFilesClicked" StartIcon="@Icons.Material.Outlined.DeleteForever" Disabled="_audiofiles.Count == 0" aria-label="@_localizer["Delete all files"]">@_localizer["Delete all files"]</MudButton>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudIconButton Color="Color.Error" Variant="Variant.Filled" OnClick="DeleteAllFilesClicked" Icon="@Icons.Material.Outlined.DeleteForever" Disabled="_audiofiles.Count == 0" aria-label="@_localizer["Delete all files"]" />
                    </MudHidden>
                </MudTooltip>
            </MudButtonGroup>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <Audiofiles Files="_audiofiles" @bind-SelectedFiles="_selectedAudiofiles" />
    </MudCardContent>
</MudCard>
<MudCard Outlined>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">@_localizer["Playback"]</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <AudioPlayer />
    </MudCardContent>
</MudCard>

@code {
    //TODO: Localization
    //TODO: Move up/down buttons for files

    Cuesheet? _cuesheet => _sessionStateContainer.GetActiveCuesheet();
    ICollection<Audiofile> _audiofiles => _cuesheet != null ? _cuesheet.Audiofiles : [];
    HashSet<Audiofile> _selectedAudiofiles = [];

    void AddButtonClicked()
    {
        var files = new List<Audiofile>(_audiofiles);
        files.Add(new());
        _cuesheetManager.SetProperty(x => x.Audiofiles, files);
    }

    void DeleteButtonClicked()
    {
        var files = new List<Audiofile>(_audiofiles);
        files.RemoveAll(x => _selectedAudiofiles.Contains(x));
        _cuesheetManager.SetProperty(x => x.Audiofiles, files);
        _selectedAudiofiles.Clear();
    }

    async Task DeleteAllFilesClicked()
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ConfirmText, _localizer["Are you sure you want to remove all files?"] },
        };
        var dialog = await _dialogService.ShowAsync<ConfirmationDialog>(_localizer["Confirm"], parameters);
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            var files = new List<Audiofile>();
            _cuesheetManager.SetProperty(x => x.Audiofiles, files);
        }
    }
}