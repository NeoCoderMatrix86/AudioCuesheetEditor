@inherits BaseLocalizedComponent

@inject IStringLocalizer<Audiofiles> _localizer
@inject ISessionStateContainer _sessionStateContainer
@inject ICuesheetManager _cuesheetManager
@inject IAudiofileManager _audiofileManager

<MudTooltip Text="@_localizer["Add file"]">
    <MudIconButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddButtonClicked" Icon="@Icons.Material.Outlined.Add" aria-label="@_localizer["Add file"]" />
</MudTooltip>

<MudExpansionPanels MultiExpansion>
    @foreach (var file in _audiofiles)
    {
        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.h6">@file.Name</MudText>
            </TitleContent>
            <ChildContent>
                @{
                    var fileInputId = $"Audiofile_{Guid.NewGuid()}";
                }
                <FileInput Id="@fileInputId" Label="@_localizer["Audiofile"]" FileName="@file.Name" OnFileSelected="(IBrowserFile? browserFile) => _audiofileManager.SetPropertiesAsync(file, browserFile, fileInputId)"
                           Filter="@String.Join(",", Audiofile.AudioCodecs.Select(x => x.MimeType))" />
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    //TODO: Remove audiofile button
    //TODO: Tracklist below each file
    //TOOD: Better handling for fileinput?!
    //TODO: Button for removing all audiofiles

    [CascadingParameter]
    public ViewMode CurrentViewMode { get; set; }

    Cuesheet? _cuesheet => _sessionStateContainer.GetActiveCuesheet();
    ICollection<Audiofile> _audiofiles => _cuesheet!.Audiofiles;

    void AddButtonClicked()
    {
        var files = new List<Audiofile>(_audiofiles);
        files.Add(new());
        _cuesheetManager.SetProperty(x => x.Audiofiles, files);
    }

    void DeleteButtonClicked(Audiofile audiofile)
    {
        var files = new List<Audiofile>(_audiofiles);
        files.Remove(audiofile);
        _cuesheetManager.SetProperty(x => x.Audiofiles, files);
    }
}
