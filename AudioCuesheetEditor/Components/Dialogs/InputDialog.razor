@typeparam T
@inherits BaseLocalizedComponent

@inject IStringLocalizer<InputDialog<T>> _localizer
@inject HotKeys _hotKeys

<MudDialog>
    <DialogContent>
        @if (IsNumericType)
        {
            <MudNumericField T="T" Value="_value" ValueChanged="OnValueChanged" Label="@Label" Placeholder="@Placeholder" Variant="Variant.Outlined" Immediate OnKeyDown="OnKeyDown"
                             Error="String.IsNullOrEmpty(_validationErrorText) == false" ErrorText="@_validationErrorText" />
        }
        else
        {
            <MudTextField T="T" Value="_value" ValueChanged="OnValueChanged" Label="@Label" Placeholder="@Placeholder" Variant="Variant.Outlined" Immediate OnKeyDown="OnKeyDown"
                          Error="String.IsNullOrEmpty(_validationErrorText) == false" ErrorText="@_validationErrorText" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="CloseDialogOk" StartIcon="@OkButtonStartIcon" Disabled="_hasValidationErrors">@OkText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    HotKeysContext? _hotKeysContext;
    T? _value;
    IEnumerable<string> _validationErrors = [];
    bool _hasValidationErrors => _validationErrors.Any();
    string? _validationErrorText => _hasValidationErrors ? string.Join(Environment.NewLine, _validationErrors) : null;

    [Parameter]
    public T? InitialValue { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? OkText { get; set; }

    [Parameter]
    public string? OkButtonStartIcon { get; set; }

    [Parameter]
    public Func<T?, IEnumerable<string>?>? Validator { get; set; }

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    bool IsNumericType => typeof(T) == typeof(short) || typeof(T) == typeof(ushort) || typeof(T) == typeof(int) || typeof(T) == typeof(uint) || typeof(T) == typeof(long) 
                       || typeof(T) == typeof(ulong) || typeof(T) == typeof(float) || typeof(T) == typeof(double) || typeof(T) == typeof(decimal);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _hotKeysContext = _hotKeys.CreateContext().Add(ModKey.None, Key.Enter, CloseDialogOk);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _value = InitialValue;
        if (String.IsNullOrEmpty(OkText))
        {
            OkText = _localizer["Ok"];
        }
    }

    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);
        _hotKeysContext?.DisposeAsync();
    }

    void ValidateValue()
    {
        _validationErrors = Validator?.Invoke(_value)?.Where(message => !string.IsNullOrWhiteSpace(message)) ?? [];
    }

    Task OnValueChanged(T? value)
    {
        _value = value;
        ValidateValue();
        return Task.CompletedTask;
    }

    void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            //Use a timer to close the dialog after a short delay to ensure that the keyboard event is fully processed before closing the dialog.
            new System.Threading.Timer(CloseDialogOk, null, 0, 10);
        }
    }

    void CloseDialogOk(object? state = null)
    {
        ValidateValue();

        if (!_hasValidationErrors)
        {
            MudDialog?.Close(_value);
        }
    }
}
