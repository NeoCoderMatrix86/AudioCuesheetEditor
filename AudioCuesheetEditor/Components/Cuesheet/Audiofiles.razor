@inherits BaseLocalizedComponent

@inject IStringLocalizer<Audiofiles> _localizer
@inject IStringLocalizer<ValidationMessage> _validationMessageLocalizer
@inject IAudiofileManager _audiofileManager
@inject IDialogManager _dialogManager

@switch (CurrentViewMode)
{
    case ViewMode.DetailView:
    case ViewMode.ImportView:
        if (Cuesheet != null)
        {
            <Alert ValidationResult="Cuesheet.Validate(nameof(Cuesheet.Audiofiles))" />
        }
        break;
}

<MudExpansionPanels MultiExpansion>
    @foreach (var file in Files)
    {
        <MudExpansionPanel Expanded>
            <TitleContent>
                <Alert ValidationResult="file.Validate()" />
                <MudStack Row AlignItems="AlignItems.Center">
                    <MudCheckBox T="Boolean" Value="@SelectedFiles.Contains(file)" ValueChanged="(selected) => SelectedChanged(file, selected)" />
                    <MudText Typo="Typo.h6" Style="width: 100%; line-break: anywhere;">@GetFileName(file)</MudText>
                    <MudFileUpload @key="file.ObjectURL" T="IBrowserFile" Accept="@String.Join(",", Audiofile.AudioCodecs.Select(x => x.MimeType))" FilesChanged="(browserFile) => FileUploaded(browserFile, file)" Hidden InputClass="file-upload">
                        <CustomContent>
                            <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Outlined.FileUpload" OnClick="context.OpenFilePickerAsync" aria-label="Upload file" />
                        </CustomContent>
                        <SelectedTemplate />
                    </MudFileUpload>
                    <MudIconButton Variant="Variant.Filled" Color="Color.Info" Icon="@Icons.Material.Outlined.EditAttributes" OnClick="() => FileRenameClicked(file)" Disabled="String.IsNullOrEmpty(file.Name)" aria-label="Rename file" />
                    <MudIconButton Variant="Variant.Filled" Color="Color.Error" Icon="@Icons.Material.Outlined.Clear" OnClick="() => _audiofileManager.ClearPropertiesAsync(file)" Disabled="String.IsNullOrEmpty(file.Name)" aria-label="Clear file" />
                </MudStack>
            </TitleContent>
            <ChildContent>
                <TrackList Audiofile="file" />
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    [Parameter]
    [EditorRequired]
    public Cuesheet? Cuesheet { get; set; }

    [Parameter]
    [EditorRequired]
    public ICollection<Audiofile> Files { get; set; }

    [CascadingParameter]
    public ViewMode CurrentViewMode { get; set; }

    [Parameter]
    public HashSet<Audiofile> SelectedFiles { get; set; } = [];

    [Parameter]
    public EventCallback<HashSet<Audiofile>> SelectedFilesChanged { get; set; }

    async Task FileRenameClicked(Audiofile audiofile)
    {
        var result = await _dialogManager.ShowInputDialogAsync<string?>(_localizer["Change file name"], _localizer["Enter the new file name here"], _localizer["New file name"], audiofile.Name);
        if (result.IsSuccess)
        {
            if (String.IsNullOrEmpty(result.Value) == false)
            {
                _audiofileManager.SetProperty(audiofile, x => x.Name, result.Value);
            }
        }
    }

    void SelectedChanged(Audiofile audiofile, Boolean selected)
    {
        if (selected)
        {
            SelectedFiles.Add(audiofile);
        }
        else
        {
            SelectedFiles.Remove(audiofile);
        }
        SelectedFilesChanged.InvokeAsync(SelectedFiles);
    }

    async Task FileUploaded(IBrowserFile? browserFile, Audiofile audiofile)
    {
        if (browserFile != null)
        {
            await _audiofileManager.SetPropertiesAsync(audiofile, browserFile);
        }
    }

    String GetFileName(Audiofile audiofile)
    {
        return String.IsNullOrEmpty(audiofile.Name) ? _localizer["No file uploaded!"] : audiofile.Name;
    }
}
