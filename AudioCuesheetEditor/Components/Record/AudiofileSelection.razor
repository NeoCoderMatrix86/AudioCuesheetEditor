@inherits BaseLocalizedComponent

@inject IStringLocalizer<AudiofileSelection> _localizer
@inject ISessionStateContainer _sessionStateContainer
@inject ICuesheetManager _cuesheetManager

<MudStack Row Justify="Justify.SpaceBetween">
    <MudSelect T="Audiofile" Value="SelectedAudioFile" ValueChanged="OnSelectedAudioFileChanged" Label="@_localizer["Select audiofile"]" Placeholder="@_localizer["Select an audiofile for recording"]" Variant="Variant.Outlined" Required Disabled="_cuesheet.IsRecording">
        @foreach (var file in _audiofiles)
        {
            <MudSelectItem T="Audiofile" Value="file">@GetFileName(file)</MudSelectItem>
        }
    </MudSelect>
    <MudButtonGroup OverrideStyles="false">
        <MudTooltip Text="@_localizer["Add file"]">
            <MudIconButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddButtonClicked" Icon="@Icons.Material.Outlined.Add" aria-label="Add file" Style="height: 56px;" Class="mt-2" Disabled="_cuesheet.IsRecording" />
        </MudTooltip>
    </MudButtonGroup>
</MudStack>

@code {
    ICollection<Audiofile> _audiofiles => _cuesheet.Audiofiles;
    Cuesheet _cuesheet => _sessionStateContainer.Cuesheet;

    [Parameter]
    public Audiofile? SelectedAudioFile { get; set; }

    [Parameter]
    public EventCallback<Audiofile?> SelectedAudioFileChanged { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _cuesheetManager.IsRecordingChanged += CuesheetManager_IsRecordingChanged;
        SetSelectedAudioFile();
    }

    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);
        _cuesheetManager.IsRecordingChanged -= CuesheetManager_IsRecordingChanged;
    }

    void AddButtonClicked()
    {
        var files = new List<Audiofile>(_audiofiles);
        files.Add(new());
        _cuesheetManager.SetProperty(x => x.Audiofiles, files);
        SetSelectedAudioFile();
    }

    void SetSelectedAudioFile()
    {
        if (_audiofiles.Count == 1)
        {
            SelectedAudioFile = _audiofiles.First();
            OnSelectedAudioFileChanged(SelectedAudioFile);
        }
    }

    String GetFileName(Audiofile audiofile) => String.IsNullOrEmpty(audiofile.Name) ? _localizer["No file uploaded!"] : audiofile.Name;

    Task OnSelectedAudioFileChanged(Audiofile? file) => SelectedAudioFileChanged.InvokeAsync(file);

    void CuesheetManager_IsRecordingChanged(object? sender, EventArgs args)
    {
        StateHasChanged();
    }
}
